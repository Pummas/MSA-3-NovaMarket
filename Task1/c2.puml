@startuml C2_NovaMarket
'!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include <C4/C4_Container.puml>


LAYOUT_WITH_LEGEND()
title Контейнерная диаграмма (C2) — NovaMarket

' ===== Акторы =====
Person(buyer, "Покупатель", "Пользователь мобильного приложения")
Person(seller, "Продавец", "Размещает товары, обрабатывает заказы")


' ===== Внешние системы =====
System_Ext(paymentGw, "Платёжный шлюз", "Внешний провайдер оплаты (карты, СБП)")
System_Ext(logistics, "Логистический провайдер", "Внешняя служба доставки")


' ===== Клиентские каналы =====
System_Boundary(clients, "Клиентские каналы") {
    Container(mobileApp, "Мобильное приложение", "iOS / Android", "MVP: единственный канал покупателя")
    Container(sellerApp, "Кабинет продавца", "Web / Mobile", "Управление товарами и заказами")
}



' ===== Платформа NovaMarket =====
System_Boundary(platform, "Платформа NovaMarket") {

    Container(gateway, "API Gateway", "NGINX", "Маршрутизация, аутентификация, rate-limiting, TLS")

    Container(catalog, "Catalog Service", "Микросервис", "Каталог, фильтры, карточки товаров. Кэш для быстрого отклика")
    Container(cart, "Cart Service", "Микросервис", "Корзина покупателя (хранится до оформления)")
    Container(order, "Order Service", "Микросервис", "Оформление заказа")
    Container(payment, "Payment Service", "Микросервис", "Интеграция с платёжным шлюзом, привязка карт")
    Container(notification, "Notification Service", "Микросервис", "Push и in-app уведомления покупателям и продавцам")
    Container(seller_manager, "Seller Service", "Микросервис", "Управление продавцами, их товарами")
    Container(delivery, "Delivery Service", "Микросервис", "Заявки в логистику, трек-номера")


    ContainerDb(catalogDb, "Catalog DB", "PostgreSQL", "Товары, категории, отзывы")
    ContainerDb(cartDb, "Cart DB", "Redis", "Корзина")
    ContainerDb(orderDb, "Order DB", "PostgreSQL", "Заказы, статусы, история")
    ContainerDb(paymentDb, "Payment DB", "PostgreSQL", "Платежи, возвраты")
    ContainerDb(notificationDb, "Notification DB", "PostgreSQL", "Актуальные уведомления, история уведомлений")
    ContainerDb(seller_managerDb, "Seller DB", "PostgreSQL", "Продавцы, их товары")
    ContainerDb(deliveryDb, "Delivery DB", "PostgreSQL", "Заявки на доставку, трекинг")



    ContainerQueue(event_bus, "Event Bus", "Kafka", "Брокер сообщений")

}


' ===== Покупатель → клиенты → gateway =====
Rel(buyer, mobileApp, "Просматривает каталог, оформляет заказ", "HTTPS")
Rel(seller, sellerApp, "Управляет товарами и заказами", "HTTPS")
Rel(mobileApp, gateway, "REST / gRPC", "HTTPS")
Rel(sellerApp, gateway, "REST", "HTTPS")


' ===== Gateway → сервисы =====
Rel(gateway, catalog, "Запросы каталога", "REST")
Rel(gateway, cart, "Операции с корзиной", "REST")
Rel(gateway, order, "Оформление и статусы заказов", "REST")
Rel(gateway, payment, "Привязка карт, статусы оплат", "REST")
Rel(gateway, seller_manager, "Запросы продавца", "REST")


' ===== Сервисы → БД =====
Rel(catalog, catalogDb, "Чтение/запись", "SQL")
Rel(cart, cartDb, "Чтение/запись", "RESP")
Rel(order, orderDb, "Чтение/запись", "SQL")
Rel(payment, paymentDb, "Чтение/запись", "SQL")
Rel(notification, notificationDb, "Чтение/запись", "SQL")
Rel(seller_manager, seller_managerDb, "Чтение/запись", "SQL")
Rel(delivery, deliveryDb, "Чтение/запись", "SQL")



' ===== Публикация событий (производители) =====
Rel(order, event_bus, "publish: OrderCreated, OrderCancelled, OrderStatusChanged", "AMQP")
Rel(payment, event_bus, "publish: PaymentSucceeded, PaymentFailed, RefundSucceeded", "AMQP")
Rel(seller_manager, event_bus, "publish: SellerOnboarded, ProductPublished, ProductUpdated, PriceChanged", "AMQP")



' ===== Подписки на события =====
Rel(event_bus, payment, "subscribe: InventoryReserved, OrderCancelled", "AMQP")
Rel(event_bus, order, "subscribe: InventoryReserved, InventoryReservationFailed, PaymentSucceeded, PaymentFailed, DeliveryDispatched, DeliveryCompleted", "AMQP")
Rel(event_bus, delivery, "subscribe: PaymentSucceeded", "AMQP")
Rel(event_bus, notification, "subscribe: OrderCreated, PaymentSucceeded, PaymentFailed, OrderStatusChanged", "AMQP")
Rel(event_bus, seller_manager, "subscribe: OrderCreated, OrderStatusChanged", "AMQP")


' ===== Внешние интеграции =====
Rel(payment, paymentGw, "Списание / возврат", "HTTPS")
Rel(delivery, logistics, "Заявки, трекинг", "HTTPS")

@enduml